#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <150>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
};

/ {
    /* The DYA input processor block wrapper */
    dya_studio_input_processor: dya_studio_input_processor {
        compatible = "zmk,studio-input-processor";
        device = <&trackball_sensor>; // This label must match your actual PMW3610 node name
    };
};


/ {
    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&kp ESC         &kp N1  &kp N2   &kp N3            &kp N4        &kp N5          &kp N6      &kp N7     &kp N8     &kp N9   &kp N0    &kp BACKSPACE
&kp TAB         &kp Q   &kp W    &kp E             &kp R         &kp T           &kp Y       &kp U      &kp I      &kp O    &kp P     &kp BSLH
&kp CAPSLOCK    &kp A   &lt 3 S  &kp D             &kp F         &kp G           &kp H       &kp J      &kp K      &kp L    &kp SEMI  &kp SQT
&kp LEFT_SHIFT  &kp Z   &kp X    &kp C             &lt 4 V       &lt 2 B         &kp N       &kp M      &kp COMMA  &kp DOT  &kp FSLH  &kp RIGHT_SHIFT
                                 &kp LEFT_CONTROL  &kp SPACE     &kp LEFT_WIN    &kp DELETE  &kp SPACE
                                                   &mo 1         &kp LEFT_ALT    &kp ENTER
            >;
        };

        F_layers {
            bindings = <
&kp F1     &kp F2  &kp F3  &kp F4  &kp F5  &kp F6        &kp F7     &kp F8     &kp F9       &kp F10    &kp F11    &kp F12
&kp GRAVE  &none   &none   &none   &none   &trans        &none      &none      &kp UP_ARROW &none      &kp MINUS  &kp EQUAL
&trans     &none   &none   &none   &none   &trans        &none      &kp LEFT   &kp DOWN     &kp RIGHT  &none      &trans
&trans     &trans  &trans  &trans  &trans  &none         &none      &mkp LCLK  &mkp RCLK    &trans     &none      &trans
                        &trans  &trans  &none         &none      &none
                                &trans  &trans        &trans
            >;
        };

        BT_layers {
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans        &trans          &trans      &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_CLR    &trans        &trans        &trans        &trans          &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &bt BT_CLR    &trans        &trans          &bt BT_NXT  &trans  &trans  &trans  &trans  &studio_unlock
                                    &trans        &trans        &trans          &trans      &trans
                                                  &trans        &trans          &trans
            >;
        };

        snipe-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &mkp LCLK &mkp RCLK  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };

        scroll-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &mkp LCLK &mkp RCLK &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans    
                                &trans  &trans    &trans
            >;
        };
    };
};
